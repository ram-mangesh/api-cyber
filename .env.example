# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Dronikastra scanner API ---
# Base URL of the scanner API. Must be reachable from the machine running
# the dashboard (or the localtunnel host). No trailing slash.
VITE_API_BASE_URL=https://your-scanner-host:3443

# API key sent as the `X-Auth` header.
VITE_DRONIKASTRA_API_KEY=

# --- Dashboard login ---
# If either value is empty the login screen will reject every attempt.
VITE_DASHBOARD_USERNAME=
VITE_DASHBOARD_PASSWORD=

# --- Twilio voice alerting (optional) ---
# Alerting is disabled unless all four of these are set.
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_TO_NUMBER=+1XXXXXXXXXX
VITE_TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Public URL that Twilio POSTs the gathered keypad press to. Leave empty only
# if you do not need the press. Never point this at a public request-catcher
# such as webhook.site in a real deployment.
VITE_TWILIO_GATHER_ACTION_URL=
